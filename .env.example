# =============================================================================
# OpsPilot Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Application ---
APP_NAME=OpsPilot
APP_ENV=development
APP_DEBUG=true

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- MCP Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8765

# --- Database: PostgreSQL ---
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot_dev
POSTGRES_DB=opspilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot_dev@localhost:5432/opspilot

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- LLM: OpenAI-compatible ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1

# --- Embedding ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=opspilot
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# --- Simulator ---
SIMULATOR_PORT=9000
