docker-compose.override.yml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Secrets
*.key
*.pem
*.p12

# Databases
*.db
*.sqlite
*.db-shm
*.db-wal
# Local database backups / schema snapshots left beside the working copy
*.db.*

# Alembic
apps/backend/alembic/versions/__pycache__/

# Local deployment scratch (old release copies, boot logs, ad-hoc probes)
.deploy/

# Build/verification scratch
.tmp/

# Agent working files
.workbuddy/

# Hosting app descriptor — contains an absolute local path
*.genie

# pip output redirected by an unquoted shell redirect, e.g. `pip install pkg >=3.0.0`
=*
