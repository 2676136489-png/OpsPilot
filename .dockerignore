!apps/frontend/README.md

# Cache
.cache/
.devcontainer/

# Docker
Dockerfile*
.dockerignore
docker-compose*.yml
docker-compose*.yaml

# Lock files (copied explicitly)
uv.lock

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Sensitive
.env.local
.env.*.local
*.key
*.pem
