__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.env
.venv
venv/
env/
.Python
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
apps/frontend/dist/

# Build artifacts
build/
dist/
*.tar.gz
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

